[Unit]
Description=ATO Computer Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ato-relay
Group=ato-relay
WorkingDirectory=/opt/ato-computer-relay
EnvironmentFile=/etc/ato-computer-relay/relay.env
ExecStart=/opt/ato-computer-relay/relay -config /etc/ato-computer-relay/relay.json
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ato-computer-relay /var/log/ato-computer-relay
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
